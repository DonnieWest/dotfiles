/* Gotham-Noir-Ultra Qt Styling */

/* Window background */
QMainWindow, QDialog, QWidget {
    background-color: #03090e;
    color: #e6f9f7;
}

/* Menus - minimal styling to avoid white rectangle artifact */
QMenu {
    background-color: #03090e;
    color: #e6f9f7;
    border: 1px solid #1e425a;
}

QMenu::item {
    color: #e6f9f7;
}

QMenu::item:disabled {
    color: #539daf;
}

QMenu::separator {
    height: 1px;
    background-color: #1e425a;
    margin: 2px 0px;
}

/* Menubar */
QMenuBar {
    background-color: #03090e;
    color: #e6f9f7;
    border-bottom: 1px solid #1e425a;
}

QMenuBar::item {
    color: #e6f9f7;
}

/* Buttons */
QPushButton {
    background-color: #0c2132;
    color: #e6f9f7;
    border: 1px solid #1e425a;
    padding: 4px 12px;
    border-radius: 2px;
}

QPushButton:hover {
    background-color: #1e425a;
}

QPushButton:pressed {
    background-color: #2b7a9c;
}

QPushButton:default {
    background-color: #8be9fd;
    color: #03090e;
    border-color: #8be9fd;
}

QPushButton:disabled {
    background-color: #03090e;
    color: #539daf;
    border-color: #1e425a;
}

/* Tool Buttons */
QToolButton {
    background-color: transparent;
    color: #e6f9f7;
    border: 1px solid transparent;
    padding: 3px;
}

QToolButton:hover {
    background-color: #1e425a;
    border: 1px solid #1e425a;
}

QToolButton:pressed {
    background-color: #2b7a9c;
}

/* Line Edits */
QLineEdit {
    background-color: #03090e;
    color: #e6f9f7;
    border: 1px solid #1e425a;
    padding: 4px;
    selection-background-color: #1e425a;
    selection-color: #e6f9f7;
}

QLineEdit:focus {
    border-color: #8be9fd;
}

/* Text Edits */
QTextEdit {
    background-color: #03090e;
    color: #e6f9f7;
    border: 1px solid #1e425a;
    selection-background-color: #1e425a;
    selection-color: #e6f9f7;
}

QPlainTextEdit {
    background-color: #03090e;
    color: #e6f9f7;
    border: 1px solid #1e425a;
    selection-background-color: #1e425a;
    selection-color: #e6f9f7;
}

/* Combo Boxes */
QComboBox {
    background-color: #0c2132;
    color: #e6f9f7;
    border: 1px solid #1e425a;
    padding: 2px 6px;
}

QComboBox:hover {
    background-color: #1e425a;
}

QComboBox::drop-down {
    border: none;
    background-color: transparent;
    width: 20px;
}

QComboBox QAbstractItemView {
    background-color: #03090e;
    color: #e6f9f7;
    border: 1px solid #1e425a;
    padding: 2px;
}

QComboBox QAbstractItemView::item {
    padding: 4px 8px;
    min-height: 18px;
}

QComboBox QAbstractItemView::item:selected {
    background-color: #1e425a;
    color: #e6f9f7;
}

/* List Views */
QListView {
    background-color: #03090e;
    color: #e6f9f7;
    border: 1px solid #1e425a;
    alternate-background-color: #0c2132;
}

QListView::item {
    padding: 2px 4px;
    min-height: 18px;
}

QListView::item:selected {
    background-color: #1e425a;
    color: #e6f9f7;
}

QListView::item:hover {
    background-color: #0c2132;
}

/* Tree Views */
QTreeView {
    background-color: #03090e;
    color: #e6f9f7;
    border: 1px solid #1e425a;
    alternate-background-color: #0c2132;
}

QTreeView::item {
    padding: 2px 4px;
    min-height: 18px;
}

QTreeView::item:selected {
    background-color: #1e425a;
    color: #e6f9f7;
}

QTreeView::item:hover {
    background-color: #0c2132;
}

QTreeView::branch {
    background-color: transparent;
}

/* Table Views */
QTableView {
    background-color: #03090e;
    color: #e6f9f7;
    border: 1px solid #1e425a;
    alternate-background-color: #0c2132;
    selection-background-color: #1e425a;
    selection-color: #e6f9f7;
    gridline-color: #1e425a;
}

QTableView::item:selected {
    background-color: #1e425a;
    color: #e6f9f7;
}

/* Headers */
QHeaderView::section {
    background-color: #0c2132;
    color: #e6f9f7;
    border: 1px solid #1e425a;
    padding: 4px;
}

/* Scrollbars */
QScrollBar:vertical {
    background-color: #03090e;
    width: 12px;
    border: 1px solid #1e425a;
}

QScrollBar::handle:vertical {
    background-color: #0c2132;
    min-height: 20px;
    border: 1px solid #1e425a;
}

QScrollBar::handle:vertical:hover {
    background-color: #1e425a;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}

QScrollBar:horizontal {
    background-color: #03090e;
    height: 12px;
    border: 1px solid #1e425a;
}

QScrollBar::handle:horizontal {
    background-color: #0c2132;
    min-width: 20px;
    border: 1px solid #1e425a;
}

QScrollBar::handle:horizontal:hover {
    background-color: #1e425a;
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0px;
}

/* Sliders */
QSlider::groove:horizontal {
    background-color: #0c2132;
    border: 1px solid #1e425a;
    height: 4px;
}

QSlider::handle:horizontal {
    background-color: #8be9fd;
    border: 1px solid #8be9fd;
    width: 12px;
    margin: -4px 0;
}

QSlider::sub-page:horizontal {
    background-color: #8be9fd;
}

QSlider::groove:vertical {
    background-color: #0c2132;
    border: 1px solid #1e425a;
    width: 4px;
}

QSlider::handle:vertical {
    background-color: #8be9fd;
    border: 1px solid #8be9fd;
    height: 12px;
    margin: 0 -4px;
}

QSlider::sub-page:vertical {
    background-color: #8be9fd;
}

/* Progress Bars */
QProgressBar {
    background-color: #0c2132;
    color: #e6f9f7;
    border: 1px solid #1e425a;
    text-align: center;
}

QProgressBar::chunk {
    background-color: #8be9fd;
}

/* Checkboxes */
QCheckBox {
    color: #e6f9f7;
}

QCheckBox::indicator {
    background-color: #0c2132;
    border: 1px solid #1e425a;
    width: 14px;
    height: 14px;
}

QCheckBox::indicator:checked {
    background-color: #8be9fd;
    border-color: #8be9fd;
}

QCheckBox::indicator:hover {
    border-color: #8be9fd;
}

/* Radio Buttons */
QRadioButton {
    color: #e6f9f7;
}

QRadioButton::indicator {
    background-color: #0c2132;
    border: 1px solid #1e425a;
    width: 14px;
    height: 14px;
    border-radius: 7px;
}

QRadioButton::indicator:checked {
    background-color: #8be9fd;
    border-color: #8be9fd;
}

QRadioButton::indicator:hover {
    border-color: #8be9fd;
}

/* Group Boxes */
QGroupBox {
    color: #e6f9f7;
    border: 1px solid #1e425a;
    margin-top: 8px;
    padding-top: 8px;
}

QGroupBox::title {
    color: #e6f9f7;
    subcontrol-origin: margin;
    left: 8px;
    padding: 0 4px;
}

/* Tabs */
QTabWidget::pane {
    border: 1px solid #1e425a;
    background-color: #03090e;
}

QTabBar::tab {
    background-color: #0c2132;
    color: #e6f9f7;
    border: 1px solid #1e425a;
    padding: 6px 12px;
    margin-right: 2px;
}

QTabBar::tab:selected {
    background-color: #03090e;
    border-bottom-color: #03090e;
}

QTabBar::tab:hover {
    background-color: #1e425a;
}

/* Splitters */
QSplitter::handle {
    background-color: #1e425a;
}

QSplitter::handle:hover {
    background-color: #8be9fd;
}

/* Tooltips */
QToolTip {
    background-color: #0c2132;
    color: #e6f9f7;
    border: 1px solid #1e425a;
    padding: 4px;
}

/* Status Bars */
QStatusBar {
    background-color: #03090e;
    color: #e6f9f7;
    border-top: 1px solid #1e425a;
}

QStatusBar::item {
    border: none;
}

/* Dock Widgets */
QDockWidget {
    color: #e6f9f7;
    titlebar-close-icon: url(close.png);
    titlebar-normal-icon: url(undock.png);
}

QDockWidget::title {
    background-color: #0c2132;
    padding: 4px;
    border: 1px solid #1e425a;
}

QDockWidget::close-button, QDockWidget::float-button {
    background-color: transparent;
    border: none;
    padding: 0px;
}

QDockWidget::close-button:hover, QDockWidget::float-button:hover {
    background-color: #1e425a;
}

/* Spin Boxes */
QSpinBox, QDoubleSpinBox {
    background-color: #03090e;
    color: #e6f9f7;
    border: 1px solid #1e425a;
    padding: 4px;
}

QSpinBox:focus, QDoubleSpinBox:focus {
    border-color: #8be9fd;
}

QSpinBox::up-button, QDoubleSpinBox::up-button,
QSpinBox::down-button, QDoubleSpinBox::down-button {
    background-color: #0c2132;
    border: 1px solid #1e425a;
    width: 16px;
}

QSpinBox::up-button:hover, QDoubleSpinBox::up-button:hover,
QSpinBox::down-button:hover, QDoubleSpinBox::down-button:hover {
    background-color: #1e425a;
}

/* Date/Time Edits */
QDateEdit, QTimeEdit, QDateTimeEdit {
    background-color: #03090e;
    color: #e6f9f7;
    border: 1px solid #1e425a;
    padding: 4px;
}

QDateEdit:focus, QTimeEdit:focus, QDateTimeEdit:focus {
    border-color: #8be9fd;
}

/* Calendars */
QCalendarWidget {
    background-color: #03090e;
}

QCalendarWidget QTableView {
    background-color: #03090e;
    alternate-background-color: #0c2132;
}

QCalendarWidget QAbstractItemView:enabled {
    color: #e6f9f7;
}

QCalendarWidget QAbstractItemView:disabled {
    color: #539daf;
}

QCalendarWidget QToolButton {
    background-color: transparent;
    color: #e6f9f7;
    border: none;
}

QCalendarWidget QToolButton:hover {
    background-color: #1e425a;
}

/* Dialogs */
QDialog {
    background-color: #03090e;
    color: #e6f9f7;
}

QDialogButtonBox {
    background-color: #03090e;
}

/* Message Boxes */
QMessageBox {
    background-color: #03090e;
    color: #e6f9f7;
}

/* Input Dialogs */
QInputDialog {
    background-color: #03090e;
    color: #e6f9f7;
}

/* File Dialogs */
QFileDialog {
    background-color: #03090e;
    color: #e6f9f7;
}

/* Font Dialogs */
QFontDialog {
    background-color: #03090e;
    color: #e6f9f7;
}

/* Color Dialogs */
QColorDialog {
    background-color: #03090e;
    color: #e6f9f7;
}

/* Focus rectangles */
QWidget:focus {
    outline: 1px solid #8be9fd;
}

/* Selected items (global) */
::selection {
    background-color: #1e425a;
    color: #e6f9f7;
}

/* Links */
QWidget[linkColor="true"] {
    color: #8be9fd;
}
