#!/usr/bin/env python3

import os
import subprocess
import sys
import urllib.error
import urllib.parse
import urllib.request


def qute_command(command):
    with open(os.environ["QUTE_FIFO"], "w") as fifo:
        fifo.write(command + "\n")


def message(kind, text):
    escaped = text.replace("\\", "\\\\").replace('"', '\\"')
    qute_command(f'message-{kind} "{escaped}"')


def defuddle_url(page_url):
    parsed = urllib.parse.urlsplit(page_url)
    if parsed.scheme not in ("http", "https") or not parsed.netloc:
        raise ValueError("Defuddle only supports HTTP(S) pages")

    target = parsed.netloc + parsed.path
    if parsed.query:
        target += "?" + parsed.query
    return "https://defuddle.md/" + urllib.parse.quote(target, safe="/:?&=+$,~!*%-._")


def copy_markdown(url):
    request = urllib.request.Request(url, headers={"User-Agent": "qutebrowser-defuddle/1.0"})
    with urllib.request.urlopen(request, timeout=60) as response:
        markdown = response.read()
    subprocess.run(["pbcopy"], input=markdown, check=True)
    message("info", "Defuddle Markdown copied")


def main():
    if not os.environ.get("QUTE_FIFO"):
        print("QUTE_FIFO not set", file=sys.stderr)
        return 1

    action = sys.argv[1] if len(sys.argv) > 1 else "copy"
    try:
        url = defuddle_url(os.environ.get("QUTE_URL", ""))
        if action == "copy":
            message("info", "Converting page with Defuddle...")
            copy_markdown(url)
        elif action == "open":
            qute_command(f"open -t {url}")
        else:
            raise ValueError(f"Unknown Defuddle action: {action}")
    except (ValueError, OSError, subprocess.SubprocessError, urllib.error.URLError) as error:
        message("error", f"Defuddle failed: {error}")
        return 1
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
