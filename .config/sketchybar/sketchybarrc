#!/usr/bin/env sh

CONFIG_DIR="$HOME/.config/sketchybar"
PLUGIN_DIR="$CONFIG_DIR/plugins"

FONT="Victor Mono:Semibold:14.0"
ICON_FONT="VictorMono Nerd Font:Semibold:15.0"
BG=0xff03090e
FG=0xffe6f9f7
GREEN=0xff50fa7b
CYAN=0xff8be9fd
BLUE=0xff0c2132
RED=0xffff5555
YELLOW=0xffffb86c

sketchybar \
  --bar height=40 \
  position=top \
  color=$BG \
  shadow=off \
  sticky=on \
  padding_left=0 \
  padding_right=0 \
  --default \
  icon.font="$ICON_FONT" \
  label.font="$FONT" \
  icon.color=$FG \
  label.color=$FG \
  background.color=$BG \
  background.height=28 \
  background.corner_radius=6 \
  icon.padding_left=2 \
  icon.padding_right=2 \
  label.padding_left=2 \
  label.padding_right=2 \
  --add event aerospace_workspace_change \
  --add item aerospace.workspaces left \
  --set aerospace.workspaces \
    drawing=off \
    updates=on \
    script="$PLUGIN_DIR/aerospace_workspaces.sh" \
  --subscribe aerospace.workspaces aerospace_workspace_change \
  --add item wifi right \
  --set wifi \
    update_freq=30 \
    script="$PLUGIN_DIR/wifi.sh" \
    icon= \
    icon.padding_left=8 icon.padding_right=4 \
    label.padding_left=2 label.padding_right=8 \
  --add item memory right \
  --set memory \
    update_freq=30 \
    script="$PLUGIN_DIR/memory.sh" \
    icon= \
    icon.padding_left=8 icon.padding_right=4 \
    label.padding_left=2 label.padding_right=8 \
  --add item volume right \
  --set volume \
    updates=on \
    update_freq=1 \
    script="$PLUGIN_DIR/volume.sh" \
    icon= \
    icon.padding_left=8 icon.padding_right=4 \
    label.padding_left=2 label.padding_right=8 \
  --subscribe volume volume_change \
  --add item corne_battery right \
  --set corne_battery \
    update_freq=300 \
    script="$PLUGIN_DIR/corne_battery.sh" \
    icon= \
    icon.padding_left=8 icon.padding_right=4 \
    label.padding_left=2 label.padding_right=8 \
  --add item battery right \
  --set battery \
    update_freq=60 \
    script="$PLUGIN_DIR/battery.sh" \
    icon= \
    icon.padding_left=8 icon.padding_right=4 \
    label.padding_left=2 label.padding_right=8 \
  --add item clock right \
  --set clock \
    update_freq=60 \
    script="$PLUGIN_DIR/clock.sh" \
    icon= \
    icon.padding_left=8 icon.padding_right=4 \
    label.padding_left=2 label.padding_right=8 \
  --hotload on
"$PLUGIN_DIR/aerospace_workspaces.sh"
