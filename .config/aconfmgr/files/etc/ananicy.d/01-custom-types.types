# Custom type definitions
# Fix: BG_CPUIO, Heavy_CPU, LowLatency_RT are commented out in 00-types.types
# but referenced by existing rules. Define them here.

# Background CPU/IO load - should be as quiet as possible
# NOTE: No cgroup assignment - cgroup v2 with systemd causes "Invalid argument"
# errors when ananicy-cpp tries to move processes between cgroups.
# nice/ioclass/sched are sufficient for deprioritization.
{"type":"BG_CPUIO", "nice":19, "ioclass":"idle", "sched":"idle"}

# Heavy CPU tasks - allowed to run but deprioritized
{"type":"Heavy_CPU", "nice":19, "ioclass":"best-effort", "ionice":7}

# Low-latency realtime - for interactive/input-critical processes
{"type":"LowLatency_RT", "nice":-10, "ioclass":"realtime"}

# Notification daemon - must respond instantly
{"type":"notification-daemon", "nice":-5, "ioclass":"best-effort", "ionice":0}

# Launcher/runner - must respond instantly to keypresses
{"type":"launcher", "nice":-10, "ioclass":"best-effort", "ionice":0}

# Input handler - keyboard/input remapping, needs low latency
{"type":"input-handler", "nice":-10, "ioclass":"realtime"}

# LSP/language server - responsive but not above the editor
{"type":"lsp-server", "nice":5, "ioclass":"best-effort", "ionice":3}

# AI/LLM inference - heavy background compute
{"type":"llm-inference", "nice":15, "ioclass":"best-effort", "ionice":6}

# Screen recording - needs steady throughput
{"type":"screen-recorder", "nice":-5, "ioclass":"best-effort", "ionice":2}

# System-critical daemon - OOM killer, memory management
{"type":"system-critical", "nice":-20, "ioclass":"best-effort", "ionice":0}

# Firewall/security - needs to stay responsive
{"type":"firewall", "nice":-5, "ioclass":"best-effort", "ionice":2}
