#!/usr/bin/env sh

CONFIG_DIR="$HOME/.config/sketchybar"
PLUGIN_DIR="$CONFIG_DIR/plugins"

FONT="Victor Mono:Semibold:14.0"
ICON_FONT="VictorMono Nerd Font:Semibold:15.0"
BG=0xff03090e
FG=0xffe6f9f7
GREEN=0xff50fa7b
CYAN=0xff8be9fd
BLUE=0xff0c2132
RED=0xffff5555
YELLOW=0xffffb86c

sketchybar \
  --bar height=40 \
  notch_display_height=40 \
  notch_width=300 \
  position=top \
  color=$BG \
  shadow=off \
  sticky=on \
  padding_left=0 \
  padding_right=0 \
  --default \
  icon.font="$ICON_FONT" \
  label.font="$FONT" \
  icon.color=$FG \
  label.color=$FG \
  background.color=$BG \
  background.height=28 \
  background.corner_radius=6 \
  icon.padding_left=2 \
  icon.padding_right=2 \
  label.padding_left=2 \
  label.padding_right=2 \
  --remove aerospace.workspaces \
  --add event aerospace_workspace_change \
  --add item aerospace.watcher left \
  --set aerospace.watcher \
    drawing=off \
    updates=on \
    script="$PLUGIN_DIR/aerospace_focus.sh" \
  --subscribe aerospace.watcher aerospace_workspace_change \
  --add item wifi right \
  --set wifi \
    update_freq=60 \
    script="$PLUGIN_DIR/wifi.sh" \
    icon= \
    icon.padding_left=8 icon.padding_right=4 \
    label.padding_left=2 label.padding_right=8 \
  --add item memory right \
  --set memory \
    update_freq=60 \
    script="$PLUGIN_DIR/memory.sh" \
    icon= \
    icon.padding_left=8 icon.padding_right=4 \
    label.padding_left=2 label.padding_right=8 \
  --add item volume right \
  --set volume \
    updates=on \
    update_freq=2 \
    script="$PLUGIN_DIR/volume.sh" \
    icon= \
    icon.padding_left=8 icon.padding_right=4 \
    label.padding_left=2 label.padding_right=8 \
  --subscribe volume volume_change \
  --add item corne_battery right \
  --set corne_battery \
    update_freq=300 \
    script="$PLUGIN_DIR/corne_battery.sh" \
    icon= \
    icon.padding_left=8 icon.padding_right=4 \
    label.padding_left=2 label.padding_right=8 \
  --add item battery right \
  --set battery \
    updates=on \
    update_freq=60 \
    script="$PLUGIN_DIR/battery.sh" \
    icon= \
    icon.padding_left=8 icon.padding_right=4 \
    label.padding_left=2 label.padding_right=8 \
  --subscribe battery power_source_change \
  --add item clock right \
  --set clock \
    update_freq=60 \
    script="$PLUGIN_DIR/clock.sh" \
    icon= \
    icon.padding_left=8 icon.padding_right=4 \
    label.padding_left=2 label.padding_right=8 \
  --hotload on

for workspace in 01 02 03 04 05 06 07 08 09 10; do
  case "$workspace" in
    01) label=Browser ;;
    02) label=Chat ;;
    03) label=Terminal ;;
    04) label=Emulator ;;
    *) label=Code ;;
  esac

  icon="${workspace#0}"
  item="aerospace.$workspace"

  sketchybar \
    --add item "$item" left \
    --set "$item" \
      drawing=off \
      icon="$icon" \
      icon.padding_left=6 \
      icon.padding_right=4 \
      label="$label" \
      label.padding_left=2 \
      label.padding_right=6 \
      background.drawing=on \
      background.color=$BG \
      click_script="aerospace workspace '$workspace'"
done

"$PLUGIN_DIR/aerospace_workspaces.sh"
NAME=volume SENDER=forced "$PLUGIN_DIR/volume.sh"
