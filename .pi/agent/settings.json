{
  "$schema": "https://pi.dev/schemas/settings.schema.json",
  "lastChangelogVersion": "1.5.0",
  "theme": "opencode-dark",
  "quietStartup": true,
  "defaultProvider": "github-copilot",
  "defaultModel": "gpt-6-luna",
  "defaultThinkingLevel": "medium",
  "defaultTools": [
    "read",
    "write",
    "edit",
    "bash",
    "grep",
    "find",
    "ls"
  ],
  "defaultProjectTrust": "ask",
  "enableSkillCommands": true,
  "externalEditor": "nvim",
  "tuiMode": "regular",
  "compaction": {
    "enabled": true,
    "reserveTokens": 16384,
    "keepRecentTokens": 20000
  },
  "retry": {
    "enabled": true,
    "maxRetries": 3,
    "baseDelayMs": 2000,
    "provider": {
      "maxRetries": 0,
      "maxRetryDelayMs": 60000
    }
  },
  "subagents": {
    "watchdog": {
      "enabled": true,
      "main": {
        "thinking": "high"
      },
      "scope": {
        "enabled": true
      },
      "autoFollow": {
        "blockers": true,
        "maxAttempts": 2,
        "stalemateRepeats": 2
      }
    }
  },
  "packages": [
    "npm:pi-web-access@0.37.0",
    "npm:pi-lens@4.4.0",
    "npm:pi-subagents@0.76.1",
    "npm:pi-leader-key@1.3.0",
    "npm:pi-cache-optimizer",
    "npm:pi-cursor-sdk",
    "npm:pi-nvim"
  ],
  "extensionChangelogVersions": {
    "{\"source\":\"npm:pi-web-access@0.37.0\",\"scope\":\"user\"}": "0.37.0",
    "{\"source\":\"npm:pi-lens@4.4.0\",\"scope\":\"user\"}": "4.4.0",
    "{\"source\":\"npm:pi-subagents@0.76.1\",\"scope\":\"user\"}": "0.76.1",
    "{\"source\":\"npm:pi-leader-key@1.3.0\",\"scope\":\"user\"}": "1.3.0",
    "{\"source\":\"npm:pi-cursor-sdk\",\"scope\":\"user\"}": "0.5.11"
  }
}