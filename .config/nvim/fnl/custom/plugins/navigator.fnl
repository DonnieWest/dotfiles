{1 :alexghergh/nvim-tmux-navigation
 :keys [:<M-Down> :<M-Left> :<M-Space> :<M-Right> :<M-Up> "<C-\\>"]
 :opts {:keybindings {:down :<M-Down>
                      :last_active "<C-\\>"
                      :left :<M-Left>
                      :next :<M-Space>
                      :right :<M-Right>
                      :up :<M-Up>}}}
