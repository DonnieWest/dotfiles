#!/bin/sh

app_name=
while [ "$#" -gt 0 ]; do
  case "$1" in
    -a|--app-name)
      [ "$#" -gt 1 ] || { printf 'notify-send: %s requires a name\n' "$1" >&2; exit 2; }
      app_name=$2
      shift 2
      ;;
    -t|--expire-time|-i|--icon|-u|--urgency)
      [ "$#" -gt 1 ] || { printf 'notify-send: %s requires a value\n' "$1" >&2; exit 2; }
      shift 2
      ;;
    -h|--help)
      printf 'Usage: notify-send [OPTIONS] SUMMARY [BODY]\n'
      exit 0
      ;;
    -*)
      printf 'notify-send: unsupported option on macOS: %s\n' "$1" >&2
      exit 2
      ;;
    *)
      break
      ;;
  esac
done

[ "$#" -ge 1 ] || { printf 'notify-send: missing summary\n' >&2; exit 2; }
[ "$#" -le 2 ] || { printf 'notify-send: expected SUMMARY and optional BODY\n' >&2; exit 2; }

summary=$1
body=${2:-}

exec /usr/bin/osascript \
  -e 'on run argv' \
  -e 'display notification (item 1 of argv) with title (item 2 of argv) subtitle (item 3 of argv)' \
  -e 'end run' \
  "$body" "$summary" "$app_name"
